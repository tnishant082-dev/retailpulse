model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["DataFolder", "fact_sales", "fact_returns", "dim_date", "dim_customer", "dim_product", "dim_country", "mart_cohort_retention", "mart_product_abc", "mart_basket_pairs", "rfm_segments", "churn_scores", "clv_scores", "forecast", "_Measures"]

ref table fact_sales
ref table fact_returns
ref table dim_date
ref table dim_customer
ref table dim_product
ref table dim_country
ref table mart_cohort_retention
ref table mart_product_abc
ref table mart_basket_pairs
ref table rfm_segments
ref table churn_scores
ref table clv_scores
ref table forecast
ref table _Measures

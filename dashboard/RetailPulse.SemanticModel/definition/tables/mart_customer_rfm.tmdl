table mart_customer_rfm

	column customer_id
		dataType: int64
		summarizeBy: none
		sourceColumn: customer_id

	column asof_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: asof_date
		annotation UnderlyingDateTimeDataType = Date

	column recency_days
		dataType: int64
		summarizeBy: none
		sourceColumn: recency_days

	column frequency_orders
		dataType: int64
		summarizeBy: none
		sourceColumn: frequency_orders

	column monetary_revenue
		dataType: double
		summarizeBy: none
		sourceColumn: monetary_revenue

	partition mart_customer_rfm = m
		mode: import
		source =
			let
				Source = Parquet.Document(File.Contents(DataFolder & "\\mart_customer_rfm.parquet")
				)
			in
				Source

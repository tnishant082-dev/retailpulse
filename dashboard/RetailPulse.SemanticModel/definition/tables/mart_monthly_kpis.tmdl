table mart_monthly_kpis

	column month
		dataType: dateTime
		summarizeBy: none
		sourceColumn: month
		annotation UnderlyingDateTimeDataType = Date

	column revenue
		dataType: double
		summarizeBy: none
		sourceColumn: revenue

	column units
		dataType: double
		summarizeBy: none
		sourceColumn: units

	column orders
		dataType: int64
		summarizeBy: none
		sourceColumn: orders

	column customers
		dataType: int64
		summarizeBy: none
		sourceColumn: customers

	column aov
		dataType: double
		summarizeBy: none
		sourceColumn: aov

	partition mart_monthly_kpis = m
		mode: import
		source =
			let
				Source = Parquet.Document(File.Contents(DataFolder & "\\mart_monthly_kpis.parquet"))
			in
				Source

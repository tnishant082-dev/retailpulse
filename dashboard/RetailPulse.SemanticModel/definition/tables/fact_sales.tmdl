				    Typed = Table.TransformColumnTypes ( Source, {{"invoice_no", type text}, {"invoice_ts", type datetime}, {"date_key", Int64.Type}, {"stock_code", type text}, {"customer_id", Int64.Type}, {"country", type text}, {"quantity", type number}, {"unit_price", type number}, {"line_revenue", type number}} )
				in

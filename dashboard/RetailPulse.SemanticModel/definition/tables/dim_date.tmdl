table dim_date
	dataCategory: Time


	column date_key
		dataType: int64
		summarizeBy: none
		sourceColumn: date_key

	column date
		isKey
		dataType: dateTime
		summarizeBy: none
		sourceColumn: date
		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		summarizeBy: none
		sourceColumn: month

	column day
		dataType: int64
		summarizeBy: none
		sourceColumn: day

	column day_of_week
		dataType: int64
		summarizeBy: none
		sourceColumn: day_of_week

	column week_of_year
		dataType: int64
		summarizeBy: none
		sourceColumn: week_of_year

	column quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter

	partition dim_date = m
		mode: import
		source =
			let
				Source = Parquet.Document(File.Contents(DataFolder & "\\dim_date.parquet"))
			in
				Source

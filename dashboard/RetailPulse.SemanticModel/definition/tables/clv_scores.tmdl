table clv_scores

	column customer_id
		dataType: int64
		summarizeBy: none
		sourceColumn: customer_id

	column clv_6m_pred
		dataType: double
		summarizeBy: none
		sourceColumn: clv_6m_pred

	partition clv_scores = m
		mode: import
		source =
			let
				Source = Parquet.Document(File.Contents(DataFolder & "\\clv_scores.parquet"))
			in
				Source

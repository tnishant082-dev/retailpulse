table _Measures
	lineageTag: 2e9691ee-5819-5c90-90a9-ef26ddf1477b

	measure 'Revenue' = SUM ( fact_sales[line_revenue] )
		formatString: £#,0
		displayFolder: Sales
		lineageTag: 7ec75c90-9341-5d04-b4a8-0ba4b9e07de9

	measure 'Orders' = DISTINCTCOUNT ( fact_sales[invoice_no] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: fe525e66-0373-5880-8017-5336a4e4361b

	measure 'Units' = SUM ( fact_sales[quantity] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 1a05f205-1df7-535f-89aa-82766db6d894

	measure 'Customers' = DISTINCTCOUNTNOBLANK ( fact_sales[customer_id] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: cb99e811-4da6-5b49-8f9d-44fdead1fc4c

	measure 'AOV' = DIVIDE ( [Revenue], [Orders] )
		formatString: £#,0.00
		displayFolder: Sales
		lineageTag: 64c95183-abc1-516a-bc01-208b0b9422e8

	measure 'Products Sold' = DISTINCTCOUNT ( fact_sales[stock_code] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: b14e48f2-3934-5208-b693-bcaa1efa6867

	measure 'Countries' = DISTINCTCOUNT ( fact_sales[country] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: ef55eb1b-d470-53b4-9e7d-fddd105a6189

	measure 'Revenue per Customer' = DIVIDE ( [Revenue], [Customers] )
		formatString: £#,0
		displayFolder: Sales
		lineageTag: 88195336-64a8-57ef-af09-f0cba84c5df8

	measure 'Revenue Share' = DIVIDE ( [Revenue], CALCULATE ( [Revenue], ALL ( dim_country ) ) )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 691da259-3319-5436-b73d-286f2184147a

	measure 'Revenue PY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: £#,0
		displayFolder: Time
		lineageTag: b14bd482-07f2-51c3-9e66-1c738129caee

	measure 'Revenue YoY %' = VAR py = [Revenue PY] RETURN IF ( NOT ISBLANK ( py ), DIVIDE ( [Revenue] - py, py ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time
		lineageTag: 41feb870-94ac-5914-b8b7-e2e305e6ecfd

	measure 'Revenue Running Total' = VAR d = MAX ( dim_date[date] ) RETURN CALCULATE ( [Revenue], dim_date[date] <= d, ALL ( dim_date ) )
		formatString: £#,0
		displayFolder: Time
		lineageTag: cb1610d6-babc-5745-92b0-f64de879a69a

	measure 'Trading Days' = COUNTROWS ( dim_date )
		formatString: #,0
		displayFolder: Time
		lineageTag: b7f29190-c08f-5ab4-907b-1312c6c1e636

	measure 'Revenue per Trading Day' = DIVIDE ( [Revenue], [Trading Days] )
		formatString: £#,0
		displayFolder: Time
		lineageTag: b337bb13-07e8-5878-b243-79bc1b2e9c44

	measure 'Return Revenue' = -SUM ( fact_returns[line_revenue] )
		formatString: £#,0
		displayFolder: Returns
		lineageTag: 1e95e8f0-d36b-5f84-b103-800f8de994f0

	measure 'Returned Units' = -SUM ( fact_returns[quantity] )
		formatString: #,0
		displayFolder: Returns
		lineageTag: 0de38692-cc78-559e-a201-cd48e307d617

	measure 'Cancelled Invoices' = DISTINCTCOUNT ( fact_returns[invoice_no] )
		formatString: #,0
		displayFolder: Returns
		lineageTag: ff7cae47-7f09-55d0-974a-bd3f67999198

	measure 'Return Rate %' = DIVIDE ( [Return Revenue], [Revenue] )
		formatString: 0.00%
		displayFolder: Returns
		lineageTag: a93548ef-6488-5e4c-b857-c9bbd4c724c6

	measure 'RFM Customers' = COUNTROWS ( rfm_segments )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 1072d47f-d323-59f8-8406-108d1663ae60

	measure 'Avg Recency Days' = AVERAGE ( rfm_segments[recency_days] )
		formatString: #,0
		displayFolder: Customers
		lineageTag: a87ee381-2abd-59e9-ab62-5d66c377fd4c

	measure 'Avg Frequency' = AVERAGE ( rfm_segments[frequency_orders] )
		formatString: 0.0
		displayFolder: Customers
		lineageTag: ab0752bb-6028-5981-a7c3-586e4b3a9daf

	measure 'Avg Monetary' = AVERAGE ( rfm_segments[monetary_revenue] )
		formatString: £#,0
		displayFolder: Customers
		lineageTag: 8cc47941-ca92-5f9e-a0dd-8978c84d4f70

	measure 'Segment Revenue' = SUM ( rfm_segments[monetary_revenue] )
		formatString: £#,0
		displayFolder: Customers
		lineageTag: f06278b2-ee5b-578b-88b6-e41bcb5ed9a4

	measure 'Champions %' = DIVIDE ( CALCULATE ( COUNTROWS ( rfm_segments ), rfm_segments[segment] = "Champions" ), CALCULATE ( COUNTROWS ( rfm_segments ), ALL ( rfm_segments[segment] ) ) )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 4aa4873e-b5e5-5698-b309-b8297fd778be

	measure 'Cohort Active' = SUM ( mart_cohort_retention[active_customers] )
		formatString: #,0
		displayFolder: Cohorts
		lineageTag: 51e87b71-f12f-5078-9f6f-7ba52a520022

	measure 'Cohort Size' = CALCULATE ( SUM ( mart_cohort_retention[active_customers] ), ALL ( mart_cohort_retention[cohort_age_months], mart_cohort_retention[activity_month] ), mart_cohort_retention[cohort_age_months] = 0 )
		formatString: #,0
		displayFolder: Cohorts
		lineageTag: 93f7b2c9-08d6-5088-9912-f02c8faf8d10

	measure 'Retention %' = DIVIDE ( [Cohort Active], [Cohort Size] )
		formatString: 0.0%
		displayFolder: Cohorts
		lineageTag: c9ab0d35-0d83-563d-b5e5-fb1df431f69c

	measure 'Month 1 Retention %' = CALCULATE ( [Retention %], mart_cohort_retention[cohort_age_months] = 1 )
		formatString: 0.0%
		displayFolder: Cohorts
		lineageTag: 6823947b-0284-50c6-b92d-82b8645d2c99

	measure 'Cohorts' = CALCULATE ( DISTINCTCOUNT ( mart_cohort_retention[cohort_month] ) )
		formatString: #,0
		displayFolder: Cohorts
		lineageTag: 0c434eab-6ff0-5e73-b838-64b995b50c2c

	measure 'Scored Customers' = COUNTROWS ( churn_scores )
		formatString: #,0
		displayFolder: Churn
		lineageTag: 97ca2bdb-883e-5735-b2b2-08906f33dfe8

	measure 'Avg Churn Probability' = AVERAGE ( churn_scores[churn_proba] )
		formatString: 0.0%
		displayFolder: Churn
		lineageTag: e87e2298-951b-5c68-8bf5-1d2408e83b8f

	measure 'High Risk Customers' = CALCULATE ( COUNTROWS ( churn_scores ), churn_scores[churn_proba] >= 0.7 )
		formatString: #,0
		displayFolder: Churn
		lineageTag: 94780773-7254-5b99-b130-f71b4595cbc1

	measure 'High Risk %' = DIVIDE ( [High Risk Customers], [Scored Customers] )
		formatString: 0.0%
		displayFolder: Churn
		lineageTag: b72b5dbd-4fab-567e-be63-13d4c296f95e

	measure 'Actual Churn Rate' = AVERAGE ( churn_scores[churned] )
		formatString: 0.0%
		displayFolder: Churn
		lineageTag: 52e17672-fbda-5f8f-9923-d2844634ac50

	measure 'Revenue at Risk' = CALCULATE ( SUM ( churn_scores[monetary_revenue] ), churn_scores[churn_proba] >= 0.7 )
		formatString: £#,0
		displayFolder: Churn
		lineageTag: 861342d9-0595-5869-a6b1-57f60d26588a

	measure 'CLV at Risk' = CALCULATE ( SUM ( churn_scores[clv_6m_pred] ), churn_scores[churn_proba] >= 0.7 )
		formatString: £#,0
		displayFolder: Churn
		lineageTag: 89d1397b-9fb6-536a-823d-868d63c283da

	measure 'Avg Predicted CLV' = AVERAGE ( clv_scores[clv_6m_pred] )
		formatString: £#,0
		displayFolder: CLV
		lineageTag: 1ccc15d5-3b9f-5e79-bfb8-f168d1dbd0ae

	measure 'Total Predicted CLV' = SUM ( clv_scores[clv_6m_pred] )
		formatString: £#,0
		displayFolder: CLV
		lineageTag: 2414ffc8-6038-5ce8-b6a0-b73e13b03c95

	measure 'CLV Customers' = COUNTROWS ( clv_scores )
		formatString: #,0
		displayFolder: CLV
		lineageTag: 0e2c4dff-9ac2-59f6-bbbc-277b81107556

	measure 'Median Predicted CLV' = MEDIAN ( clv_scores[clv_6m_pred] )
		formatString: £#,0
		displayFolder: CLV
		lineageTag: 63222401-ff8c-56b9-9130-8271f28fd7e4

	measure 'ABC Revenue' = SUM ( mart_product_abc[revenue] )
		formatString: £#,0
		displayFolder: Products
		lineageTag: 7e1dc11b-c66f-5d65-b7fe-134a476ee0e1

	measure 'ABC Products' = COUNTROWS ( mart_product_abc )
		formatString: #,0
		displayFolder: Products
		lineageTag: 2bbe1d9b-54bb-55bb-9c79-c803c8c88496

	measure 'ABC Revenue Share' = DIVIDE ( [ABC Revenue], CALCULATE ( [ABC Revenue], ALL ( mart_product_abc ) ) )
		formatString: 0.0%
		displayFolder: Products
		lineageTag: 8dc43ae9-e091-581c-bfa2-6e413dee026b

	measure 'Pair Orders' = SUM ( mart_basket_pairs[pair_orders] )
		formatString: #,0
		displayFolder: Products
		lineageTag: 65494698-ba95-58e5-b15d-d9feae027553

	measure 'Product Pairs' = COUNTROWS ( mart_basket_pairs )
		formatString: #,0
		displayFolder: Products
		lineageTag: 0c1054dd-4774-5768-81ec-8b10918e650a

	measure 'Top Pair Orders' = MAX ( mart_basket_pairs[pair_orders] )
		formatString: #,0
		displayFolder: Products
		lineageTag: 2bd2bfe7-a0ae-5986-84d5-b98615f594bd

	measure 'Actual Units' = SUM ( forecast[units] )
		formatString: #,0
		displayFolder: Forecast
		lineageTag: 41f81189-2dda-5b37-a1e5-4b2fea850cd4

	measure 'Baseline Units' = SUM ( forecast[pred_baseline] )
		formatString: #,0
		displayFolder: Forecast
		lineageTag: 06c0c3d0-235e-53ac-aefe-378d07a468fd

	measure 'Model Units' = SUM ( forecast[pred_model] )
		formatString: #,0
		displayFolder: Forecast
		lineageTag: 40ac1b63-a004-5f3a-936a-a501d11f6b3e

	measure 'WAPE Model' = DIVIDE ( SUMX ( forecast, ABS ( forecast[units] - forecast[pred_model] ) ), SUM ( forecast[units] ) )
		formatString: 0.0%
		displayFolder: Forecast
		lineageTag: e3f2b572-dbd7-54f6-b663-c8677ea52b61

	measure 'WAPE Baseline' = DIVIDE ( SUMX ( forecast, ABS ( forecast[units] - forecast[pred_baseline] ) ), SUM ( forecast[units] ) )
		formatString: 0.0%
		displayFolder: Forecast
		lineageTag: f71d00b6-04be-59a1-a368-61167c1c8a57

	measure 'Forecast Products' = DISTINCTCOUNT ( forecast[stock_code] )
		formatString: #,0
		displayFolder: Forecast
		lineageTag: d28aa37d-6b26-5913-bd97-96e6c3349717

	column Value
		dataType: string
		isHidden
		lineageTag: 37705944-d256-5aa3-9951-ea57c5d3946c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = ROW ( "Value", BLANK () )
